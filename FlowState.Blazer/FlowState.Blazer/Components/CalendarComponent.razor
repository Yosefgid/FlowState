@using FlowState.Models
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="google-calendar">
    <div class="calendar-toolbar">
        <div class="calendar-toolbar-left">
            <button class="nav-button" @onclick="PreviousMonth">‹</button>

            <h2>@currentMonth.ToString("MMMM yyyy")</h2>

            <button class="nav-button" @onclick="NextMonth">›</button>
        </div>

        <button class="google-connect-button @(isGoogleConnected ? "connected" : "")"
                @onclick="ConnectGoogleCalendar">
            @(isGoogleConnected ? "Import Google Calendar Events" : "Connect to Google Calendar")
        </button>
    </div>

    <div class="calendar-weekdays">
        <div>Mon</div>
        <div>Tue</div>
        <div>Wed</div>
        <div>Thu</div>
        <div>Fri</div>
        <div>Sat</div>
        <div>Sun</div>
    </div>

    <div class="calendar-grid">
        @foreach (var day in CalendarDays)
        {
            <div class="calendar-cell @(day.Month != currentMonth.Month ? "other-month" : "")">
                <div class="day-number @(day.Date == DateTime.Today ? "today" : "")">
                    @day.Day
                </div>

                <div class="events-list">
                    @foreach (var task in GetTasksForDay(day))
                    {
                        <div class="calendar-event"
                             title="@task.Description"
                             @onclick="() => OpenTaskModal(task)">
                            <span class="event-time">@task.StartDate.ToString("HH:mm")</span>
                            <span class="event-title">@task.Name</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@if (selectedTask is not null)
{
    <div class="modal-backdrop">
        <div class="task-modal">
            <div class="task-modal-header">
                <h3>Edit Event</h3>
                <button class="close-button" @onclick="CloseTaskModal">×</button>
            </div>

            <label class="modal-label">Name</label>
            <input class="modal-input" @bind="selectedTask.Name" />

            <label class="modal-label">Description</label>
            <textarea class="modal-textarea" @bind="selectedTask.Description"></textarea>

            <label class="checkbox-row">
                <input type="checkbox" @bind="selectedTask.IsCompleted" />
                Completed
            </label>

            <div class="task-modal-actions">
                <button class="cancel-button" @onclick="CloseTaskModal">Cancel</button>
                <button class="save-button" @onclick="SaveTaskChanges">Save</button>
            </div>
        </div>
    </div>
}

<style>
    .google-calendar {
        width: 100%;
        height: calc(100vh - 150px);
        background: #fff;
        border: 1px solid #dadce0;
        border-radius: 12px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        font-family: Arial, sans-serif;
    }

    .calendar-toolbar {
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 20px;
        border-bottom: 1px solid #dadce0;
        background: #fff;
    }

    .calendar-toolbar-left {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .calendar-toolbar h2 {
        margin: 0;
        font-size: 22px;
        font-weight: 400;
        color: #3c4043;
    }

    .nav-button {
        width: 36px;
        height: 36px;
        border: none;
        border-radius: 50%;
        background: transparent;
        font-size: 28px;
        line-height: 1;
        cursor: pointer;
        color: #5f6368;
    }

        .nav-button:hover {
            background: #f1f3f4;
        }

    .google-connect-button {
        border: 1px solid #dadce0;
        background: white;
        color: #1a73e8;
        border-radius: 999px;
        padding: 8px 14px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
    }

        .google-connect-button:hover {
            background: #f1f3f4;
        }

        .google-connect-button.connected {
            color: #188038;
            border-color: #188038;
            background: #e6f4ea;
        }

    .calendar-weekdays {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        border-bottom: 1px solid #dadce0;
        background: #fff;
    }

        .calendar-weekdays div {
            padding: 10px 8px;
            text-align: center;
            font-size: 12px;
            font-weight: 500;
            color: #70757a;
            text-transform: uppercase;
        }

    .calendar-grid {
        flex: 1;
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        grid-template-rows: repeat(6, 1fr);
    }

    .calendar-cell {
        border-right: 1px solid #dadce0;
        border-bottom: 1px solid #dadce0;
        padding: 6px;
        min-width: 0;
        overflow: hidden;
        background: #fff;
    }

        .calendar-cell:nth-child(7n) {
            border-right: none;
        }

    .other-month {
        background: #f8f9fa;
        color: #9aa0a6;
    }

    .day-number {
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 4px;
        font-size: 13px;
        color: #3c4043;
        border-radius: 50%;
    }

    .other-month .day-number {
        color: #9aa0a6;
    }

    .day-number.today {
        background: #1a73e8;
        color: white;
        font-weight: 600;
    }

    .events-list {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .calendar-event {
        background: #1a73e8;
        color: white;
        border-radius: 4px;
        padding: 3px 6px;
        font-size: 12px;
        display: flex;
        gap: 5px;
        align-items: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        cursor: pointer;
    }

        .calendar-event:hover {
            background: #1558b0;
        }

    .event-time {
        font-weight: 600;
        flex-shrink: 0;
    }

    .event-title {
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .task-modal {
        width: 430px;
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
        font-family: Arial, sans-serif;
    }

    .task-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
    }

        .task-modal-header h3 {
            margin: 0;
            font-size: 20px;
            font-weight: 500;
            color: #3c4043;
        }

    .close-button {
        border: none;
        background: transparent;
        font-size: 26px;
        cursor: pointer;
        color: #5f6368;
    }

    .modal-label {
        display: block;
        font-size: 13px;
        color: #5f6368;
        margin-bottom: 4px;
    }

    .modal-input,
    .modal-textarea {
        width: 100%;
        border: 1px solid #dadce0;
        border-radius: 6px;
        padding: 8px;
        margin-bottom: 14px;
        font-size: 14px;
    }

    .modal-textarea {
        min-height: 90px;
        resize: vertical;
    }

    .checkbox-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 18px;
        font-size: 14px;
        color: #3c4043;
    }

    .task-modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .cancel-button,
    .save-button {
        border: none;
        border-radius: 6px;
        padding: 8px 14px;
        font-size: 14px;
        cursor: pointer;
    }

    .cancel-button {
        background: #f1f3f4;
        color: #3c4043;
    }

    .save-button {
        background: #1a73e8;
        color: white;
    }

        .save-button:hover {
            background: #1558b0;
        }
</style>

@code {
    private List<ToDoTask> tasks = new();

    private ToDoTask? selectedTask;

    private bool isGoogleConnected;

    private DateTime currentMonth = new DateTime(
        DateTime.Today.Year,
        DateTime.Today.Month,
        1
    );

    protected override async Task OnInitializedAsync()
    {
        await LoadGoogleStatus();
        await LoadTasks();
    }

    private async Task LoadTasks()
    {
        var result = await Http.GetFromJsonAsync<List<ToDoTask>>("api/calendar");

        if (result is not null)
        {
            tasks = result;
        }
    }

    private async Task LoadGoogleStatus()
    {
        var result = await Http.GetFromJsonAsync<GoogleStatusResponse>("api/google-tasks/status");

        if (result is not null)
        {
            isGoogleConnected = result.IsConnected;
        }
    }

    private async Task ConnectGoogleCalendar()
    {
        if (isGoogleConnected)
        {
            await Http.PostAsync("api/google-tasks/import", null);
            await LoadTasks();
            return;
        }

        Navigation.NavigateTo("http://localhost:5170/api/google-tasks/connect", forceLoad: true);
    }

    private void OpenTaskModal(ToDoTask task)
    {
        selectedTask = new ToDoTask(
            task.Name,
            task.Description,
            task.GoogleId ?? ""
        )
        {
            Id = task.Id,
            IsCompleted = task.IsCompleted,
            TimeCompleted = task.TimeCompleted,
            TimeSet = task.TimeSet,
            StartDate = task.StartDate,
            EndDate = task.EndDate,
            Category = task.Category
        };
    }

    private void CloseTaskModal()
    {
        selectedTask = null;
    }

    private async Task SaveTaskChanges()
    {
        if (selectedTask is null)
        {
            return;
        }

        if (selectedTask.IsCompleted && selectedTask.TimeCompleted is null)
        {
            selectedTask.TimeCompleted = DateTime.Now;
        }

        if (!selectedTask.IsCompleted)
        {
            selectedTask.TimeCompleted = null;
        }

        var response = await Http.PutAsJsonAsync(
            $"api/tasks/{selectedTask.Id}",
            selectedTask
        );

        if (response.IsSuccessStatusCode)
        {
            await LoadTasks();
            CloseTaskModal();
        }
    }

    private IEnumerable<DateTime> CalendarDays
    {
        get
        {
            var firstDayOfMonth = currentMonth;
            var startOffset = ((int)firstDayOfMonth.DayOfWeek + 6) % 7;
            var calendarStart = firstDayOfMonth.AddDays(-startOffset);

            return Enumerable.Range(0, 42)
                .Select(i => calendarStart.AddDays(i));
        }
    }

    private IEnumerable<ToDoTask> GetTasksForDay(DateTime day)
    {
        return tasks
            .Where(t => t.StartDate.Date == day.Date)
            .OrderBy(t => t.StartDate);
    }

    private void PreviousMonth()
    {
        currentMonth = currentMonth.AddMonths(-1);
    }

    private void NextMonth()
    {
        currentMonth = currentMonth.AddMonths(1);
    }

    private class GoogleStatusResponse
    {
        public bool IsConnected { get; set; }
    }
}