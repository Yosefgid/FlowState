
@code {
    // ── Stat cards ──────────────────────────────────────────────────────────
    private readonly List<(string Title, string Value, string Change, bool Positive, IconName Icon, string Accent)> Stats = new()
    {
        ("Focus Hours",  "32.5h",   "+12%",   true,  IconName.Clock,      "cyan"),
        ("Tasks Done",   "47",      "+8%",    true,  IconName.CheckSquare,"green"),
        ("Streak",       "14 days", "New PR", true,  IconName.Fire,       "orange"),
        ("Avg. Score",   "8.4/10",  "-0.3",   false, IconName.Star,       "purple"),
    };

    // ── Bar chart data ───────────────────────────────────────────────────────
    private readonly int[] FocusData   = { 4, 6, 5, 8, 7, 9, 6 };
    private readonly int[] TaskData    = { 5, 7, 6, 9, 8, 10, 7 };
    private readonly string[] DayLabels = { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
    private int MaxVal => Math.Max(FocusData.Max(), TaskData.Max()) + 1;
    private double BarHeight(int val) => (val / (double)MaxVal) * 100;

    // ── Tasks ────────────────────────────────────────────────────────────────
    private List<TaskItem> Tasks = new()
    {
        new("Design new onboarding flow",   "Design",      "High",   true),
        new("Write weekly retrospective",   "Writing",     "Medium", false),
        new("Review Q2 analytics report",  "Analytics",   "High",   false),
        new("Update habit tracker config", "Productivity","Low",    true),
        new("Deep work: feature spec doc", "Writing",     "High",   false),
    };

    // ── Sessions ─────────────────────────────────────────────────────────────
    private readonly List<SessionItem> Sessions = new()
    {
        new("Deep Work — Code",   "09:00", "11:30", 9.2, "#22d3ee"),
        new("Email & Planning",   "12:00", "12:45", 6.1, "#a78bfa"),
        new("Design Review",      "14:00", "15:30", 8.4, "#34d399"),
        new("Learning — Reading", "17:00", "18:00", 7.8, "#fb923c"),
    };

    // ── Goals ────────────────────────────────────────────────────────────────
    private readonly List<GoalItem> Goals = new()
    {
        new("Weekly Focus Hours", 32.5, 40,  "cyan"),
        new("Tasks Completed",    47,   60,  "green"),
        new("Reading Pages",      95,   120, "purple"),
    };

    private void ToggleTask(TaskItem t) => t.Done = !t.Done;

    private Color PriorityColor(string p) => p switch
    {
        "High"   => Color.Danger,
        "Medium" => Color.Warning,
        _        => Color.Success
    };

    record TaskItem(string Name, string Tag, string Priority, bool Done)
    {
        public bool Done { get; set; } = Done;
    }
    record SessionItem(string Name, string Start, string End, double Score, string Color);
    record GoalItem(string Name, double Current, double Target, string Accent);
}

<div class="dashboard">

    <!-- ── STAT CARDS ──────────────────────────────────────────────────────── -->
    <Row Gutter="Gutter.Is4" Class="mb-4">
        @foreach (var s in Stats)
        {
            <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnTablet.Is12.OnMobile">
                <StatCard Title="@s.Title"
                          Value="@s.Value"
                          Change="@s.Change"
                          IsPositive="@s.Positive"
                          Icon="@s.Icon"
                          Accent="@s.Accent" />
            </Column>
        }
    </Row>

    <!-- ── MID ROW: Chart + Goals ──────────────────────────────────────────── -->
    <Row Gutter="Gutter.Is4" Class="mb-4">

        <!-- Weekly Activity Bar Chart -->
        <Column ColumnSize="ColumnSize.Is8.OnDesktop.Is12.OnMobile">
            <Card Class="h-100">
                <CardHeader>
                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
                        <CardTitle>Weekly Activity</CardTitle>
                        <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is3">
                            <Span Class="legend-dot cyan me-1"></Span><Text Class="small">Focus</Text>
                            <Span Class="legend-dot green me-1"></Span><Text Class="small">Tasks</Text>
                        </Div>
                    </Div>
                </CardHeader>
                <CardBody>
                    <div class="bar-chart">
                        @for (int i = 0; i < DayLabels.Length; i++)
                        {
                            var fi = i;
                            <div class="bar-group">
                                <div class="bars">
                                    <div class="bar cyan-bar"
                                         style="height:@(BarHeight(FocusData[fi]))%"
                                         title="Focus: @FocusData[fi]h"></div>
                                    <div class="bar green-bar"
                                         style="height:@(BarHeight(TaskData[fi]))%"
                                         title="Tasks: @TaskData[fi]"></div>
                                </div>
                                <span class="bar-label">@DayLabels[fi]</span>
                            </div>
                        }
                    </div>
                </CardBody>
            </Card>
        </Column>

        <!-- Goal Progress -->
        <Column ColumnSize="ColumnSize.Is4.OnDesktop.Is12.OnMobile">
            <Card Class="h-100">
                <CardHeader>
                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
                        <CardTitle>Weekly Goals</CardTitle>
                        <Anchor To="/goals" Class="card-link">View all →</Anchor>
                    </Div>
                </CardHeader>
                <CardBody>
                    <Div Flex="Flex.Column" Gap="Gap.Is4">
                        @foreach (var g in Goals)
                        {
                            var pct = (int)Math.Min((g.Current / g.Target) * 100, 100);
                            <div class="goal-item">
                                <Div Flex="Flex.JustifyContent.Between" Class="mb-1">
                                    <Text Class="goal-name">@g.Name</Text>
                                    <Text TextColor="TextColor.Muted" Class="small">@g.Current / @g.Target</Text>
                                </Div>
                                <Progress Class="progress-track ">
                                    <ProgressBar Value="@pct" />
                                </Progress>
                                <Text TextColor="TextColor.Muted" Class="small text-end mt-1">@pct%</Text>
                            </div>
                        }
                    </Div>
                </CardBody>
            </Card>
        </Column>

    </Row>

    <!-- ── BOTTOM ROW: Tasks + Sessions ────────────────────────────────────── -->
    <Row Gutter="Gutter.Is4">

        <!-- Task List -->
        <Column ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile">
            <Card>
                <CardHeader>
                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
                        <CardTitle>Today's Tasks</CardTitle>
                        <Badge Color="Color.Info">@Tasks.Count(t => !t.Done) remaining</Badge>
                    </Div>
                </CardHeader>
                <CardBody Class="p-0">
                    <ListGroup Flush>
                        @foreach (var task in Tasks)
                        {
                            <ListGroupItem Class="@($"task-item {(task.Done ? "done" : "")}")">
                                <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is3">
                                    <Check TValue="bool"
                                           Checked="@task.Done"
                                           CheckedChanged="@(() => ToggleTask(task))" />
                                    <Div>
                                        <Text Class="@($"task-name {(task.Done ? "text-decoration-line-through text-muted" : "")}")">
                                            @task.Name
                                        </Text>
                                        <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is2" Class="mt-1">
                                            <Badge Color="Color.Secondary" Class="tag-badge">@task.Tag</Badge>
                                            <Badge Color="@PriorityColor(task.Priority)">@task.Priority</Badge>
                                        </Div>
                                    </Div>
                                </Div>
                            </ListGroupItem>
                        }
                    </ListGroup>
                </CardBody>
            </Card>
        </Column>

        <!-- Sessions -->
        <Column ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile">
            <Card>
                <CardHeader>
                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
                        <CardTitle>Today's Sessions</CardTitle>
                        <Anchor To="/sessions" Class="card-link">View all →</Anchor>
                    </Div>
                </CardHeader>
                <CardBody>
                    <Div Flex="Flex.Column" Gap="Gap.Is3">
                        @foreach (var s in Sessions)
                        {
                            <Card Class="session-item border">
                                <CardBody Class="py-2 px-3">
                                    <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is3">
                                        <div class="session-color-bar" style="background:@s.Color"></div>
                                        <Div Class="flex-grow-1">
                                            <Text Class="session-name fw-semibold">@s.Name</Text>
                                            <Text TextColor="TextColor.Muted" Class="small">@s.Start – @s.End</Text>
                                        </Div>
                                        <Div Class="session-score" style="color:red">
                                            @s.Score<span class="score-denom">/10</span>
                                        </Div>
                                    </Div>
                                </CardBody>
                            </Card>
                        }
                    </Div>
                </CardBody>
            </Card>
        </Column>

    </Row>

</div>
