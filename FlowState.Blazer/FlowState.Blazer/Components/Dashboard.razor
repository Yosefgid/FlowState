
<div class="dashboard">

    <!-- Right: Controls -->
    <div class="d-flex align-items-center gap-3 mb-3">

        <Dropdown>
            <DropdownToggle Color="Color.Secondary" Outline>
                <Icon Name="IconName.Clock" Class="me-2" />
                @selectedRange
            </DropdownToggle>
            <DropdownMenu>
                @foreach (var r in ranges)
                {
                    <DropdownItem Active="r == selectedRange"
                                  Clicked="() => SelectRange(r)">
                        @r
                    </DropdownItem>
                }
            </DropdownMenu>
        </Dropdown>

        <Button Color="Color.Primary">
            <Icon Name="IconName.Add" Class="me-1" />
            New Session
        </Button>

    </div>

    <!-- ── STAT CARDS ──────────────────────────────────────────────────────── -->
    <Row Gutter="Gutter.Is4" Class="mb-4">
        @foreach (var s in Stats)
        {
            <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnTablet.Is12.OnMobile">
                <StatCard Title="@s.Title"
                          Value="@s.Value"
                          Change="@s.Change"
                          IsPositive="@s.Positive"
                          Icon="@s.Icon"
                          Accent="@s.Accent" />
            </Column>
        }
    </Row>

    <!-- ── MID ROW Goals ──────────────────────────────────────────── -->
    <Row Gutter="Gutter.Is4" Class="mb-4">

        <!-- Weekly Activity Bar Chart -->
        <Column ColumnSize="ColumnSize.IsFull.OnDesktop.Is12.OnMobile">
            <Card Class="">
                <CardHeader>
                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
                        <CardTitle>Modules</CardTitle>
                        <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is3">
                            @*<Span Class="legend-dot cyan me-1"></Span><Text Class="small">Focus</Text>
                            <Span Class="legend-dot green me-1"></Span><Text Class="small">Tasks</Text>*@
                        </Div>
                    </Div>
                </CardHeader>
                <CardBody Class="scroll-row">
                    <Div style=" text-align:center">
                        <Card Style="flex-shrink:0">
                            <CardBody Class="module">
                        
                             
                            </CardBody>
                       
                        </Card>
                        <Text >Eisenhower</Text>
                    </Div>  
                    
                    <Div style=" text-align:center">
                        <Card Style="flex-shrink:0">
                            <CardBody Class="module">


                            </CardBody>

                        </Card>
                        <Text>Eisenhower</Text>
                    </Div>

                    <Div style=" text-align:center">
                        <Card Style="flex-shrink:0">
                            <CardBody Class="module">


                            </CardBody>

                        </Card>
                        <Text>Eisenhower</Text>
                    </Div>

                    <Div style=" text-align:center">
                        <Card Style="flex-shrink:0">
                            <CardBody Class="module">


                            </CardBody>

                        </Card>
                        <Text>Eisenhower</Text>
                    </Div>

                </CardBody>

            </Card>
        </Column>

       

    </Row>

    <!-- ── BOTTOM ROW: Tasks + Sessions ────────────────────────────────────── -->
    <Row Gutter="Gutter.Is4" Class="pb-4">

        <!-- Task List -->
        <Column ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile">
            <Card>
                <CardHeader>
                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
                        <CardTitle>Today's Tasks</CardTitle>
                        <Badge Color="Color.Info">@DailyTasks.Count(t => !t.IsCompleted) remaining</Badge>
                    </Div>
                </CardHeader>
                <CardBody Class="p-0">
                    <ListGroup Flush>
                        @foreach (var task in DailyTasks)
                        {
                            <ListGroupItem Class="@($"task-item {(task.IsCompleted ? "done" : "")}")">
                                <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is3">
                                    <Check TValue="bool"
                                           Checked="@task.IsCompleted"
                                           CheckedChanged="@(() => ToggleTask(task))" />
                                    <Div>
                                        <Text Class="@($"task-name {(task.IsCompleted ? "text-decoration-line-through text-muted" : "")}")">
                                            @task.Name
                                        </Text>
                                        <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is2" Class="mt-1">
                                            @* <Badge Color="Color.Secondary" Class="tag-badge">@task.Tag</Badge>
                                            <Badge Color="@PriorityColor(task.Priority)">@task.Priority</Badge> *@
                                        </Div>
                                    </Div>
                                </Div>
                            </ListGroupItem>
                        }
                    </ListGroup>
                </CardBody>
            </Card>
        </Column>

        <!-- Sessions -->
        <Column ColumnSize="ColumnSize.Is5.OnDesktop.Is12.OnMobile">
            <Card Class=" ms-3">
                <CardHeader>
                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
                        <CardTitle>Session Tasks Complete Rate</CardTitle>
                        <Anchor To="/goals" Class="card-link">View all →</Anchor>
                    </Div>
                </CardHeader>
                <CardBody>
                    <Div Flex="Flex.Column" Gap="Gap.Is4">
                        @foreach (var g in Goals)
                        {
                            var pct = (int)Math.Min((g.Current / g.Target) * 100, 100);
                            <div class="goal-item">
                                <Div Flex="Flex.JustifyContent.Between" Class="mb-1">
                                    <Text Class="goal-name">@g.Name</Text>
                                    <Text TextColor="TextColor.Muted" Class="small">@g.Current / @g.Target</Text>
                                </Div>
                                <Progress Class="progress-track ">
                                    <ProgressBar Value="@pct" />
                                </Progress>
                                <Text TextColor="TextColor.Muted" Class="small text-end mt-1">@pct%</Text>
                            </div>
                        }
                    </Div>
                </CardBody>
            </Card>
        </Column>

    </Row>

</div>

@code {

    [Parameter]
    public List<ToDoTask> Tasks { get; set; }

    // ── Session edit ──────────────────────────────────────────────────────────
    private string selectedRange = "Session0";
    private readonly string[] ranges = { "Session0", "Session1", "Session2", "Session3", "Session4" };

    private void SelectRange(string range) => selectedRange = range;
    // ── Stat cards ──────────────────────────────────────────────────────────
    private List<(string Title, string Value, string Change, bool Positive, IconName Icon, string Accent)> Stats => new()
    {
        ("Focus Hours",  "32.5h",   "+12%",   true,  IconName.Clock,       "cyan"),
        ("Tasks Done",   GetTasksDone(), "+8%", true,  IconName.CheckSquare, "green"),
        ("Streak",       "14 days", "New PR", true,  IconName.Fire,        "orange"),
        ("Today's Tasks", GetTasksDone(), "-0.3", false, IconName.Star, "purple"),
    };

    // ── Bar chart data ───────────────────────────────────────────────────────
    private readonly int[] FocusData = { 4, 6, 5, 8, 7, 9, 6 };
    private readonly int[] TaskData = { 5, 7, 6, 9, 8, 10, 7 };
    private readonly string[] DayLabels = { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
    private int MaxVal => Math.Max(FocusData.Max(), TaskData.Max()) + 1;
    private double BarHeight(int val) => (val / (double)MaxVal) * 100;

    // ── Tasks ────────────────────────────────────────────────────────────────
    private List<ToDoTask> DailyTasks = new()
    {
        new ToDoTask("Finish API", "Complete CRUD endpoints for ToDo API", "google-1"),
        new ToDoTask("Study EF Core", "Review tracking, migrations, and relationships", "google-2"),
        new ToDoTask("Fix Toggle Bug", "Debug why IsCompleted is not persisting", "google-3"),
        new ToDoTask("Frontend UI", "Build Blazor or React task UI", "google-4"),
        new ToDoTask("Write Tests", "Add unit tests for service layer", "google-5")
    };

    // ── Sessions ─────────────────────────────────────────────────────────────
    private readonly List<SessionItem> Sessions = new()
    {
        new("Deep Work — Code",   "09:00", "11:30", 9.2, "#22d3ee"),
        new("Email & Planning",   "12:00", "12:45", 6.1, "#a78bfa"),
        new("Design Review",      "14:00", "15:30", 8.4, "#34d399"),
        new("Learning — Reading", "17:00", "18:00", 7.8, "#fb923c"),
    };

    // ── Goals ────────────────────────────────────────────────────────────────
    private readonly List<GoalItem> Goals = new()
    {
        new("Session0", 32.5, 40,  "cyan"),
        new("Session1",    47,   60,  "green"),
        new("Session2",      95,   120, "purple"),
    };

    private void ToggleTask(ToDoTask t) => t.IsCompleted = !t.IsCompleted;

    private Color PriorityColor(string p) => p switch
    {
        "High" => Color.Danger,
        "Medium" => Color.Warning,
        _ => Color.Success
    };

    private string GetTasksDone()
    {
        if (Tasks == null || Tasks.Count == 0)
            return "0/0";

        return $"{Tasks.Count(x => x.IsCompleted)}/{Tasks.Count}";
    }

    record SessionItem(string Name, string Start, string End, double Score, string Color);
    record GoalItem(string Name, double Current, double Target, string Accent);
}
