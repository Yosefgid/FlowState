@layout PublicLayout
@page "/register"
@rendermode InteractiveServer
@using FlowState.Blazer.Models.Auth
@using FlowState.Blazer.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo">⚡</div>
            <h4 class="auth-title">FlowState</h4>
            <p class="auth-subtitle">Create your workspace</p>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="auth-error">@_error</div>
        }

        <div class="auth-field">
            <label class="auth-label">Username</label>
            <input class="auth-input" placeholder="yourname" @bind="_request.Username" />
        </div>

        <div class="auth-field">
            <label class="auth-label">Email</label>
            <input class="auth-input" type="email" placeholder="you@example.com" @bind="_request.Email" />
        </div>

        <div class="auth-field">
            <label class="auth-label">Password</label>
            <input class="auth-input" type="password" placeholder="••••••••" @bind="_request.Password" />
        </div>

        <div class="auth-field">
            <label class="auth-label">Confirm Password</label>
            <input class="auth-input" type="password" placeholder="••••••••" @bind="_request.ConfirmPassword" />
        </div>

        <button class="auth-button" @onclick="HandleRegister" disabled="@_loading">
            @if (_loading)
            {
                <span>Registering..</span>
            }
            else
            {
                <span>Create account</span>
            }
        </button>

        <hr class="auth-divider" />

        <p class="auth-footer">Already have an account? <a class="auth-link" href="/login">Login</a></p>
    </div>
</div>

@code {
    private RegisterRequest _request = new();
    private string? _error;
    private bool _loading;

    private async Task HandleRegister()
    {
        _error = null;
        _loading = true;
        var (success, error) = await AuthService.RegisterAsync(_request);
        if (success)
        {
            Navigation.NavigateTo("/dashboard");
        }
        else
        {
            _error = error;
        }
        _loading = false;
    }
}