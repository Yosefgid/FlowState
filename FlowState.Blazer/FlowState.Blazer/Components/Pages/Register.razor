@layout PublicLayout
@page "/register"
@rendermode InteractiveServer
@using FlowState.Blazer.Models.Auth
@using FlowState.Blazer.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-4">
                <h3 class="mb-4">Create Account</h3>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger">
                        @_error 
                    </div>
                    
                }
                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <input class="form-control" @bind="_request.Username"/>
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input class="form-control" type="email" @bind="_request.Email" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input class="form-control" type="password" @bind="_request.Password" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Confirm Password</label>
                    <input class="form-control" type="password" @bind="_request.ConfirmPassword" />
                </div>

                <button class="btn btn-primary w-100" @onclick="HandleRegister" disabled="@_loading">
                    @if (_loading)
                    {
                        <span>
                            Registering..
                        </span>
                    }
                    else
                    {
                        <span>Register</span>
                    }
                </button>
                <p class="mt-3" text-center>Already have an account? <a href="/login">Login</a></p>

            </div>
        </div>
    </div>
    

</div>

@code {
    private RegisterRequest _request = new();
    private string? _error;
    private bool _loading;

    private async Task HandleRegister()
    {
        _error =null;
        _loading = true;
        var (success, error) = await AuthService.RegisterAsync(_request);
        if (success)
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            _error = error;
        }
        _loading = false;
    }
    

}
