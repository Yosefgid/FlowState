@layout PublicLayout
@page "/login"
@rendermode InteractiveServer
@using FlowState.Blazer.Models.Auth
@using FlowState.Blazer.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo">⚡</div>
            <h4 class="auth-title">FlowState</h4>
            <p class="auth-subtitle">Let's Get You In the Flow</p>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="auth-error">@_error</div>
        }

        <div class="auth-field">
            <label class="auth-label">Email</label>
            <input class="auth-input" type="email" placeholder="you@example.com" @bind="_request.Email" />
        </div>

        <div class="auth-field">
            <label class="auth-label">Password</label>
            <input class="auth-input" type="password" placeholder="••••••••" @bind="_request.Password" />
        </div>

        <button class="auth-button" @onclick="HandleLogin" disabled="@_loading">
            @if (_loading)
            {
                <span>Logging in..</span>
            }
            else
            {
                <span>Sign in</span>
            }
        </button>

        <hr class="auth-divider" />

        <p class="auth-footer">Don't have an account? <a class="auth-link" href="/register">Create one</a></p>
    </div>
</div>

@code {
    private LoginRequest _request = new();
    private string? _error;
    private bool _loading;

    private async Task HandleLogin()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_request.Email) ||
            string.IsNullOrWhiteSpace(_request.Password))
        {
            _error = "Email and password are required.";
            return;
        }

        _loading = true;
        var (success, error) = await AuthService.LoginAsync(_request);
        if (success)
        {
            Navigation.NavigateTo("/dashboard");
        }
        else
        {
            _error = error;
        }
        _loading = false;
    }
}