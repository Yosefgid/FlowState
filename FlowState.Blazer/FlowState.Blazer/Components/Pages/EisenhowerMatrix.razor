@using Functionality;
@using FlowState.Models;
@inherits BaseEisenhowerMatrix
@rendermode InteractiveServer
@page "/eisen"

<div class="eisenhower-matrix">

    <!-- Header -->
    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Class="mb-3">
        @* <Div>
            <Heading Size="HeadingSize.Is5" Class="mb-0">Eisenhower Matrix</Heading>
            <Text TextColor="TextColor.Muted" Class="small">Drag tasks between quadrants to reprioritise</Text>
        </Div> *@
        <Badge Style="color: black">@AllTasks.Count task@(AllTasks.Count == 1 ? "" : "s")</Badge>
    </Div>

    <Div Class ="matrix-axis-wrapper">

        <!-- Y-axis label -->
        <div class="axis-label axis-y" >
            <span>URGENT →</span>
        </div>
       
    <Div Style="display:flex; align-items:stretch;">
      
            <DropContainer Class="matrix-grid" TItem="ToDoTask" Items="@TaskState.Tasks" 
            ItemsFilter="@((item, dropZone) => EisenToString[item.Category]== dropZone)" ItemDropped="@ItemDropped">
            <ChildContent>
                <DropZone Class ="quadrant q1 " TItem="ToDoTask" Name=@EisenToString[EisenCat.Do] Border="Border.Rounded" Flex="Flex.Grow.Is1">
                    <Heading Size="HeadingSize.Is4" Margin="Margin.Is3.FromBottom">Do</Heading>
                    <div class="matrix-col-header" style="grid-column:2">
                        <span class="axis-chip important">⚡ Important</span>
                    </div>
                    <div class="matrix-row-header" style="grid-row:2">
                        <span class="axis-chip urgent">🔥 Urgent</span>
                    </div>
                </DropZone>
                <DropZone Class ="quadrant q2" TItem="ToDoTask" Name=@EisenToString[EisenCat.Schedule] Border="Border.Rounded" Flex="Flex.Grow.Is1">
                    <Heading Size="HeadingSize.Is4" Margin="Margin.Is3.FromBottom">Schedule</Heading>
                    <div class="matrix-col-header" style="grid-column:3">
                        <span class="axis-chip not-important">Not Important</span>
                    </div>
                    </DropZone>
                <DropZone Class ="quadrant q3"TItem="ToDoTask" Name=@EisenToString[EisenCat.Delegate] Border="Border.Rounded" Flex="Flex.Grow.Is1">
                    <Heading Size="HeadingSize.Is4" Margin="Margin.Is3.FromBottom">Delegate</Heading>
                    <div class="matrix-row-header" style="grid-row:3">
                        <span class="axis-chip not-urgent">Not Urgent</span>
                    </div>
                </DropZone>
                <DropZone Class ="quadrant q4"TItem="ToDoTask" Name=@EisenToString[EisenCat.Eliminate] Border="Border.Rounded" Flex="Flex.Grow.Is1">
                    <Heading Size="HeadingSize.Is4" Margin="Margin.Is3.FromBottom">Eliminate</Heading>
                </DropZone>
            </ChildContent>
            <ItemTemplate >                
                <Card Shadow="Shadow.Default" Margin="Margin.Is3.OnY">
                    <CardBody>
                        <div class="task-card @(context.IsCompleted ? "task-done" : "")">                        
                            <div class="task-card-inner">
                                <Check TValue="bool"
                                       Checked="@context.IsCompleted"
                                       CheckedChanged="@(async (bool isChecked) => await ToggleTask(context, isChecked))"
                                       Class="task-check" />
                                <div class="task-text">
                                    <span class="task-name @(context.IsCompleted ? "strikethrough" : "")">@context.Name</span>
                                    @if (!string.IsNullOrWhiteSpace(context.Description))
                                    {
                                        <span class="task-desc">@context.Description</span>
                                    }
                                </div>
                                <span class="drag-handle">⠿</span>
                            </div>
                        </div>
                    </CardBody>
                </Card>
            </ItemTemplate> 
        </DropContainer>
        </Div>
        
    </Div>

    <div class="axis-label axis-x">
        <span>IMPORTANCE →</span>
    </div>

</div>

<style>
    /* ── Layout ──────────────────────────────────────────────────────────────── */
    .eisenhower-matrix {
        font-family: inherit;
        margin-right: 50px;
        margin-bottom: 50px;
    }

    .matrix-axis-wrapper {
        display: flex;
        flex-direction: column;
    }

    /* ── Column headers (Important / Not Important) ──────────────────────────── */
    .matrix-col-headers {
        display: flex;
        margin-left: 2rem; /* align with grid, not the row-label strip */
        margin-bottom: 0.5rem;
        gap: 0.75rem;
    }

        .matrix-col-headers .axis-chip {
            flex: 1;
            text-align: center;
        }

    /* ── Row labels + grid side by side ─────────────────────────────────────── */
    .matrix-body {
        display: flex;
        align-items: stretch;
        gap: 0.5rem;
    }

    /* ── Row headers (Urgent / Not Urgent) ───────────────────────────────────── */
    .matrix-row-headers {
        display: flex;
        flex-direction: column;
        width: 1.75rem;
        flex-shrink: 0;
        gap: 0.75rem;
    }

        .matrix-row-headers .axis-chip {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            writing-mode: vertical-rl;
            transform: rotate(180deg);
            white-space: nowrap;
            padding: 0.5rem 0.2rem;
        }

    /* ── The 2x2 drop grid ───────────────────────────────────────────────────── */
    .matrix-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
        gap: 0.75rem;
        flex: 1;
    }

    /* ── Axis chips ──────────────────────────────────────────────────────────── */
    .axis-chip {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: .08em;
        padding: 0.2rem 0.65rem;
        border-radius: 999px;
        text-transform: uppercase;
    }

        .axis-chip.important {
            background: rgba(239,68,68,.15);
            color: #f87171;
        }

        .axis-chip.not-important {
            background: rgba(107,114,128,.15);
            color: #9ca3af;
        }

        .axis-chip.urgent {
            background: rgba(239,68,68,.15);
            color: #f87171;
        }

        .axis-chip.not-urgent {
            background: rgba(107,114,128,.15);
            color: #9ca3af;
        }

    /* ── Quadrants ───────────────────────────────────────────────────────────── */
    .quadrant {
        border-radius: 0.75rem;
        padding: 0.75rem;
        min-height: 200px;
        transition: box-shadow 0.15s, background 0.15s;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }


    /* Do — Important + Urgent */
    .q1 {
        background: rgba(239, 68, 68, 0.07);
        border: 1px solid rgba(239,68,68,0.2);
    }

    /* Schedule — Important + Not Urgent */
    .q2 {
        background: rgba(34, 211, 238, 0.07);
        border: 1px solid rgba(34,211,238,0.2);
    }

    /* Delegate — Not Important + Urgent */
    .q3 {
        background: rgba(251, 191, 36, 0.07);
        border: 1px solid rgba(251,191,36,0.2);
    }

    /* Eliminate — Not Important + Not Urgent */
    .q4 {
        background: rgba(107, 114, 128, 0.07);
        border: 1px solid rgba(107,114,128,0.2);
    }

    .quadrant.drag-over {
        box-shadow: 0 0 0 2px rgba(167,139,250,0.6);
        background: rgba(167,139,250,0.1);
    }

    /* ── Quadrant header ─────────────────────────────────────────────────────── */
    .quadrant-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.25rem;
    }

    .q-label {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: .1em;
        color: #9ca3af;
    }

    .q-subtitle {
        font-size: 0.7rem;
        color: #6b7280;
        margin-top: -0.35rem;
        margin-bottom: 0.25rem;
        display: block;
    }

    /* ── Task list ───────────────────────────────────────────────────────────── */
    .task-list {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        flex: 1;
    }

    .empty-hint {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        color: #4b5563;
        border: 1.5px dashed #374151;
        border-radius: 0.5rem;
        padding: 1rem;
        min-height: 60px;
    }

    /* ── Task card ───────────────────────────────────────────────────────────── */
    .task-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 0.5rem;
        padding: 0.45rem 0.6rem;
        cursor: grab;
        transition: background 0.1s, opacity 0.1s, transform 0.1s;
        user-select: none;
    }

        .task-card:hover {
            background: rgba(255,255,255,0.08);
            transform: translateY(-1px);
        }

        .task-card:active {
            cursor: grabbing;
        }

        .task-card.task-done {
            opacity: 0.45;
        }

    .task-card-inner {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
    }

    .task-check {
        margin-top: 2px;
        flex-shrink: 0;
    }

    .task-text {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        min-width: 0;
    }

    .task-name {
        font-size: 0.8rem;
        font-weight: 500;
        color: black;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

        .task-name.strikethrough {
            text-decoration: line-through;
            color: #6b7280;
        }

    .task-desc {
        font-size: 0.7rem;
        color: #6b7280;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .drag-handle {
        font-size: 1rem;
        color: #4b5563;
        flex-shrink: 0;
        line-height: 1;
        margin-top: 1px;
    }

    .task-card:hover .drag-handle {
        color: #9ca3af;
    }


</style>
