@using Functionality;
@using FlowState.Models;
@inherits BaseEisenhowerMatrix
@rendermode InteractiveServer
@page "/eisen"

<div class="eisenhower-matrix">

    <!-- Header -->
    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Class="mb-3">
        @* <Div>
            <Heading Size="HeadingSize.Is5" Class="mb-0">Eisenhower Matrix</Heading>
            <Text TextColor="TextColor.Muted" Class="small">Drag tasks between quadrants to reprioritise</Text>
        </Div> *@
        <Badge Style="color: black">@AllTasks.Count task@(AllTasks.Count == 1 ? "" : "s")</Badge>
    </Div>

    <!-- Y-axis label -->
    <Div class="axis-label axis-y">
        <Span>URGENT →</Span>
    </Div>

    <Div Class ="matrix-axis-wrapper">

        
        <Div Class="matrix-col-labels">
            <Span Class="axis-chip important">⚡ Important</Span>
            <Span Class="axis-chip not-important">Not Important</Span>
        </Div>

        <Div Style="display:flex; ">

            <Div Class="matrix-row-labels">
                <Span Class="axis-chip urgent">🔥 Urgent</Span>
                <Span Class="axis-chip not-urgent">Not Urgent</Span>
            </Div>

                <DropContainer Class="matrix-grid" TItem="ToDoTask" Items="@TaskState.Tasks"
                           ItemsFilter="@((item, dropZone) => TaskState.EisenToString[item.Category]== dropZone)" ItemDropped="@ItemDropped">
                <ChildContent>
                    <DropZone Class="quadrant q1 " TItem="ToDoTask" Name=@TaskState.EisenToString[EisenCat.Do] Border="Border.Rounded" Flex="Flex.Grow.Is1">
                        <Div Class="quadrant-header">
                            <Heading Size="HeadingSize.Is4" Margin="Margin.Is3.FromBottom">Do</Heading>   
                            <Badge Style="background-color:crimson">
                                @TaskState.CatCount(EisenCat.Do) Tasks
                            </Badge>
                        </Div>
                        @if (!TaskState.Tasks.Any(x => x.Category == EisenCat.Do))
                        {
                            <Div Class="empty-hint">Drop tasks here</Div>
                        }
                    </DropZone>
                    <DropZone Class="quadrant q2" TItem="ToDoTask" Name=@TaskState.EisenToString[EisenCat.Schedule] Border="Border.Rounded" Flex="Flex.Grow.Is1">
                        <Div Class="quadrant-header">
                            <Heading Size="HeadingSize.Is4" Margin="Margin.Is3.FromBottom">Schedule</Heading>
                            <Badge Style="background-color:blue">
                                @TaskState.CatCount(EisenCat.Schedule) Tasks
                            </Badge>
                        </Div>
                        @if (!TaskState.Tasks.Any(x => x.Category == EisenCat.Schedule))
                        {
                            <Div Class="empty-hint">Drop tasks here</Div>
                        }
                    </DropZone>
                    <DropZone Class="quadrant q3" TItem="ToDoTask" Name=@TaskState.EisenToString[EisenCat.Delegate] Border="Border.Rounded" Flex="Flex.Grow.Is1">
                        <Div Class="quadrant-header">
                            <Heading Size="HeadingSize.Is4" Margin="Margin.Is3.FromBottom">Delegate</Heading>
                            <Badge Style="background-color:darkorange" >
                                @TaskState.CatCount(EisenCat.Delegate) Tasks
                            </Badge>
                        </Div>
                        @if (!TaskState.Tasks.Any(x => x.Category == EisenCat.Delegate))
                        {
                            <Div Class="empty-hint">Drop tasks here</Div>
                        }
                    </DropZone>
                    <DropZone Class="quadrant q4" TItem="ToDoTask" Name=@TaskState.EisenToString[EisenCat.Eliminate] Border="Border.Rounded" Flex="Flex.Grow.Is1">
                        <Div Class="quadrant-header">
                            <Heading Size="HeadingSize.Is4" Margin="Margin.Is3.FromBottom">Eliminate</Heading>
                            <Badge Style="background-color:black">
                                @TaskState.CatCount(EisenCat.Eliminate) Tasks
                            </Badge>
                        </Div>
                        @if (!TaskState.Tasks.Any(x => x.Category == EisenCat.Eliminate))
                        {
                            <Div Class="empty-hint">Drop tasks here</Div>
                        }
                    </DropZone>
                </ChildContent>
                <ItemTemplate >                
                    <Card Shadow="Shadow.Default" Margin="Margin.Is3.OnY">
                        <CardBody>
                            <div class="task-card @(context.IsCompleted ? "task-done" : "")">                        
                                <div class="task-card-inner">
                                    <Check TValue="bool"
                                           Value="@context.IsCompleted"
                                           ValueChanged="@(async (bool isChecked) => await ToggleTask(context, isChecked))"
                                           Class="task-check" />
                                    <div class="task-text">
                                            <Span Class="task-name">@context.Name</Span>
                                        @if (!string.IsNullOrWhiteSpace(context.Description))
                                        {
                                            <span class="task-desc">@context.Description</span>
                                        }
                                    </div>
                                    <span class="drag-handle">⠿</span>
                                </div>
                            </div>
                        </CardBody>
                    </Card>
                </ItemTemplate> 
            </DropContainer>
            </Div>    
        
        </Div>

    <Div Class="axis-label axis-x">
        <Span>IMPORTANCE →</Span>
    </Div>

</div>

<style>
    /* ── Layout ──────────────────────────────────────────────────────────────── */
    .eisenhower-matrix {
        font-family: inherit;
        margin-inline:20px;
    }

    .matrix-axis-wrapper {
        position: relative;
        
        padding-bottom: 1.75rem;
        
    }
    
    .matrix-grid {
        display: grid;
        grid-template-columns: 5rem 1fr 1fr;
        grid-template-rows: auto 1fr 1fr;
        gap: 0.75rem;
        height: 700px;
        
    }

    /* ── Axis labels ─────────────────────────────────────────────────────────── */

    .axis-label {
        position: absolute;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: .12em;
        color: #6b7280;
        text-transform: uppercase;
    }

    .axis-y {
        left: 260px;
        top: 50%;
        transform: translateX(-50%) translateY(-50%) rotate(-90deg);
        white-space: nowrap;
        margin-right: 10px;
    }

    .axis-x {
        bottom: 0;
        left: 55%;
        transform: translateX(-50%);
        white-space: nowrap;
    }

    .axis-y, .axis-x {
        transition: opacity 0.2s ease;
    }

    /* ── Header chips ────────────────────────────────────────────────────────── */
    .matrix-col-header,
    .matrix-row-header {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* ── Column headers (Important / Not Important) ──────────────────────────── */
    .matrix-col-labels {
        display: grid;
        grid-template-columns: 1fr 1fr;
        margin-left: 50px;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
    }

        .matrix-col-labels .axis-chip {
            text-align: center;
        }

        
    /* ── Row labels + grid side by side ─────────────────────────────────────── */
    .matrix-row-labels {
        display: grid;
        grid-template-rows: 1fr 1fr;
        width: 50px;
        gap: 0.75rem;
        
    }

        .matrix-row-labels .axis-chip {
            transform: rotate(-90deg);
            white-space: nowrap;
            width: max-content;
            align-self: center;
            text-align: center;
        }

    /* ── Row headers (Urgent / Not Urgent) ───────────────────────────────────── */
    

        

    /* ── The 2x2 drop grid ───────────────────────────────────────────────────── */
    .matrix-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
        gap: 0.75rem;
        flex: 1;
    }

    /* ── Axis chips ──────────────────────────────────────────────────────────── */
    .axis-chip {
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: .08em;
        padding: 0.2rem 0.65rem;
        border-radius: 999px;
        text-transform: uppercase;
    }

        .axis-chip.important {
            background: rgba(239,68,68,.15);
            color: #f87171;
            text-align: center;
        }

        .axis-chip.not-important {
            background: rgba(107,114,128,.15);
            color: #9ca3af;
            text-align: center;
        }

        .axis-chip.urgent {
            background: rgba(239,68,68,.15);
            color: #f87171;
            text-align: center;
            margin-left: -2rem;
        }

        .axis-chip.not-urgent {
            background: rgba(107,114,128,.15);
            color: #9ca3af;
            text-align: center;
            margin-left: -2.5rem;
        }

    /* ── Quadrants ───────────────────────────────────────────────────────────── */
    .quadrant {
        border-radius: 0.75rem;
        min-height: 0;
        transition: box-shadow 0.15s, background 0.15s;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        overflow-y: auto;   /* scroll when content overflows */
        padding: 1rem;
    }

    .quadrant-header {
        display: flex;
        justify-content: space-between;
        align-items: center;    
    }


    /* Do — Important + Urgent */
    .q1 {
        background: rgba(239, 68, 68, 0.07);
        border: 1px solid rgba(239,68,68,0.2);
    }

    /* Schedule — Important + Not Urgent */
    .q2 {
        background: rgba(34, 211, 238, 0.07);
        border: 1px solid rgba(34,211,238,0.2);
    }

    /* Delegate — Not Important + Urgent */
    .q3 {
        background: rgba(251, 191, 36, 0.07);
        border: 1px solid rgba(251,191,36,0.2);
    }

    /* Eliminate — Not Important + Not Urgent */
    .q4 {
        background: rgba(107, 114, 128, 0.07);
        border: 1px solid rgba(107,114,128,0.2);
    }

   

    /* ── Quadrant header ─────────────────────────────────────────────────────── */
    

    /* ── Task list ───────────────────────────────────────────────────────────── */
    

    .empty-hint {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        color: #4b5563;
        border: 1.5px dashed #374151;
        border-radius: 0.5rem;
        padding: 1rem;
        min-height: 60px;
    }

    /* ── Task card ───────────────────────────────────────────────────────────── */
    .task-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 0.5rem;
        padding: 0.45rem 0.6rem;
        cursor: grab;
        transition: background 0.1s, opacity 0.1s, transform 0.1s;
        user-select: none;
    }

        .task-card:hover {
            background: rgba(255,255,255,0.08);
            transform: translateY(-1px);
        }

        .task-card:active {
            cursor: grabbing;
        }

        .task-card.task-done {
            opacity: 0.45;
        }

    .task-card-inner {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
    }

    .task-check {
        margin-top: 2px;
        flex-shrink: 0;
    }

    .task-text {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        min-width: 0;
    }

    .task-name {
        font-size: 0.8rem;
        font-weight: 500;
        color: black;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

        .task-name.strikethrough {
            text-decoration: line-through;
            color: #6b7280;
        }

    .task-desc {
        font-size: 0.7rem;
        color: #6b7280;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .drag-handle {
        font-size: 1rem;
        color: #4b5563;
        flex-shrink: 0;
        line-height: 1;
        margin-top: 1px;
    }

    .task-card:hover .drag-handle {
        color: #9ca3af;
    }


</style>
