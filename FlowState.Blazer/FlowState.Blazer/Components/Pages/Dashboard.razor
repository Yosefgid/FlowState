@inject NavigationManager Navigation
@inject TaskStateService TaskState
@page "/dashboard"

@rendermode InteractiveServer
<div class="dashboard">

    <!-- Right: Controls -->
    <div class="d-flex align-items-center gap-3 mb-3">

        <Dropdown>
            <DropdownToggle Color="Color.Secondary" Outline>
                <Icon Name="IconName.Folder" Class="me-2" />
                @if (!loaded)
                {
                    <Text>Loading...</Text>
                }
                else
                {
                    <Text>@sessions[selectedSession]</Text>
                }
            </DropdownToggle>
            <DropdownMenu>

                @if (sessions == null)
                {
                    <Div>Loading...</Div>
                }
                else
                {
                    @foreach (var r in sessions)
                    {
                        <DropdownItem Active="r.Value == sessions[selectedSession]"
                                      Clicked="() => RefreshDashboard(r.Key)">
                            @r.Value
                        </DropdownItem>
                    }
                }
                
            </DropdownMenu>
        </Dropdown>

        <Button Color="Color.Primary" Clicked="OpenSessionModal">
            <Icon Name="IconName.Add" Class="me-1" />
            New Session
        </Button>

    </div>

    <Modal @ref="sessionModal">
        <ModalContent>
            <ModalHeader>
                <ModalTitle>Create Session</ModalTitle>
            </ModalHeader>

            <ModalBody>
                <Field>
                    <Label>Session Name</Label>
                    <TextInput @bind-Value="newSessionName" />
                </Field>
            </ModalBody>

            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseSessionModal">
                    Cancel
                </Button>

                <Button Color="Color.Primary"
                        Clicked="CreateSession">
                    Confirm
                </Button>
            </ModalFooter>
        </ModalContent>
    </Modal>

    <!-- ── STAT CARDS ──────────────────────────────────────────────────────── -->
    <Row Gutter="Gutter.Is4" Class="mb-4">
        @foreach (var s in Stats)
        {
            <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnTablet.Is12.OnMobile">
                <StatCard Title="@s.Title"
                          Value="@s.Value"
                          Change="@s.Change"
                          IsPositive="@s.Positive"
                          Icon="@s.Icon"
                          Accent="@s.Accent" />
            </Column>
        }
    </Row>

    <!-- ── MID ROW Goals ──────────────────────────────────────────── -->
    <Row Gutter="Gutter.Is4" Class="mb-4">

        <!-- Weekly Activity Bar Chart -->
        <Column ColumnSize="ColumnSize.IsFull.OnDesktop.Is12.OnMobile">
            <Card Class="">
                <CardHeader>
                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
                        <CardTitle>Modules</CardTitle>
                        <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is3">
                            @*<Span Class="legend-dot cyan me-1"></Span><Text Class="small">Focus</Text>
                            <Span Class="legend-dot green me-1"></Span><Text Class="small">Tasks</Text>*@
                        </Div>
                    </Div>
                </CardHeader>
                <CardBody Class="scroll-row">
                    <Div Style="text-align:center">
                        <Card Style="flex-shrink:0; cursor:pointer"
                              @onclick="() => ToEisen()">

                            <CardBody Class="module">
                                <Div class="mini-grid">
                                    <Div Style="background-color: orangered;">@TaskState.CatCount(EisenCat.Do)</Div>
                                    <Div Style="background-color: dodgerblue">@TaskState.CatCount(EisenCat.Schedule)</Div>
                                    <Div Style="background-color: darkorange">@TaskState.CatCount(EisenCat.Delegate)</Div>
                                    <Div Style="background-color: gray">@TaskState.CatCount(EisenCat.Eliminate)</Div>
                                </Div>
                            </CardBody>

                        </Card>

                        <Text>Eisenhower Matrix</Text>
                    </Div>
                    
                    <Div style=" text-align:center">
                        <Card Style="flex-shrink:0">
                            <CardBody Class="module" >
                                <WeeklyCompletionGraph currentSession="@selectedSession" />
                            </CardBody>

                        </Card>
                        <Text>Completion Graph</Text>
                    </Div>
                     
                    <Div style=" text-align:center">
                        <Card Style="flex-shrink:0">
                            <CardBody Class="module p-3" Style="font-size:3rem; background-color: skyblue;" Flex="Flex.AlignItems.Center">
                                <Text >@motivationalQuotes[random.Next(motivationalQuotes.Count)]</Text>
                            </CardBody>
                        </Card>
                        <Text>Motivation</Text>
                    </Div>

                </CardBody>

            </Card>
        </Column>

       

    </Row>

    <!-- ── BOTTOM ROW: Tasks + Sessions ────────────────────────────────────── -->
    <Row Gutter="Gutter.Is4" Class="pb-4">

        <!-- Task List -->
        <Column ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile">
            <Card>
                <CardHeader>
                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
                        <CardTitle>Today's Tasks</CardTitle>
                        <Badge Style="background-color:darkblue">@DailyTasks.Count(t => !t.IsCompleted) remaining</Badge>
                    </Div>
                </CardHeader>
                <CardBody Class="p-0 scroll-column">
                    <ListGroup Flush Class="w-100">
                        @foreach (var task in DailyTasks)
                        {
                            <ListGroupItem Class="@($"task-item {(task.IsCompleted ? "done" : "")}")">
                                <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is3">
                                    <Check TValue="bool"
                                           Value="@task.IsCompleted"
                                           ValueChanged="@(async (bool isChecked) => await ToggleTask(task, isChecked))" />
                                    <Div>
                                        <Div Flex="Flex.Column">
                                            <Text Class="@($"task-name {(task.IsCompleted ? "text-decoration-line-through text-muted" : "")}")">
                                                @task.Name
                                            </Text>
                                            <Text Class="@($"task-desc {(task.IsCompleted ? "text-decoration-line-through text-muted" : "")}")">
                                                @task.Description
                                            </Text>
                                        </Div>
                                        <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is2" Class="mt-1">
                                            <Badge Style="@(task.IsCompleted ? "background-color: darkgreen" : "background-color: blue")" Class="tag-badge">@(task.IsCompleted ? "Completed" : "Active")</Badge>
                                            <Badge Style="@PriorityColor(task.Category)">
                                                @TaskState.EisenToString[task.Category]
                                                </Badge>
                                        </Div>
                                    </Div>
                                </Div>
                            </ListGroupItem>
                        }
                    </ListGroup>
                </CardBody>
            </Card>
        </Column>

        <!-- Sessions -->
        <Column ColumnSize="ColumnSize.Is5.OnDesktop.Is12.OnMobile">
            <Card Class=" ms-3">
                <CardHeader>
                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
                        <CardTitle>Session Tasks Complete Rate</CardTitle>
                        @* <Anchor To="/goals" Class="card-link">View all →</Anchor> *@
                    </Div>
                </CardHeader>
                <CardBody>
                    <Div Flex="Flex.Column" Gap="Gap.Is4" Class="scroll-column">
                        @foreach (var g in Goals)
                        {
                            var pct = g.Target == 0 ? 0 : (int)Math.Min((g.Current * 100.0 / g.Target), 100);
                            <div class="goal-item">
                                <Div Flex="Flex.JustifyContent.Between" Class="mb-1">
                                    <Text Class="goal-name">@g.Name</Text>
                                    <Text TextColor="TextColor.Muted" Class="small">@g.Current / @g.Target</Text>
                                </Div>
                                <Progress Class="progress-track ">
                                    <ProgressBar Value="@pct" />
                                </Progress>
                                <Text TextColor="TextColor.Muted" Class="small text-end mt-1">@pct%</Text>
                            </div>
                        }
                    </Div>
                </CardBody>
            </Card>
        </Column>

    </Row>

</div>

@code {

    private List<ToDoTask> Tasks ;

    public bool loaded = false;

    // ── Session edit ──────────────────────────────────────────────────────────
    private int selectedSession = 0;
    private Dictionary<int, string> sessions { get; set; } = new();
    private List<GoalItem> Goals { get; set; } = new();

    // ── Stat cards ──────────────────────────────────────────────────────────
    private List<(string Title, string Value, string Change, bool Positive, IconName Icon, string Accent)> Stats => new()
    {
        ("Flow Hours",  "2.5h",   "+12%",   true,  IconName.Clock,       "cyan"),
        ("Tasks Done",   GetTasksDone(Tasks), "+8%", true,  IconName.CheckSquare, "green"),
        ("Streak",       "14 days", "New PR", true,  IconName.Fire,        "orange"),
        ("Today's Tasks", GetTasksDone(DailyTasks), "-0.3", false, IconName.Star, "purple"),
    };

    private List<ToDoTask> DailyTasks { get; set; } = new()
    {

    };

    record SessionItem(string Name, string Start, string End, double Score, string Color);
    record GoalItem(string Name, int Current, int Target, string Accent);

    private Modal sessionModal;

    private string newSessionName = "";

    private Random random = new();


    protected override async Task OnInitializedAsync()
    {    
        await TaskState.RefreshSessions(false);

        await TaskState.RefreshTasks(selectedSession);

        Tasks = TaskState.Tasks;

        TaskState.Sessions.ForEach(x => sessions.Add(x.Id, x.Name));



        TaskState.Sessions.ForEach(x => Goals.Add(new(x.Name, TaskState.CompletedCount[x.Id][0],
            TaskState.CompletedCount[x.Id][1], "green")));

        loaded = true;


        DailyTasks = Tasks.Where(x => x.EndDate.Day == DateTime.Now.Day).ToList();


    }   

    private async Task RefreshDashboard(int range)
    {
        selectedSession = range;
        if (range == -1)
        {
            await TaskState.RefreshTasks();

        }
        else
        {
            await TaskState.RefreshTasks(range);
        }

        Tasks = TaskState.Tasks;
        DailyTasks = Tasks.Where(x => x.EndDate.Day == DateTime.Now.Day).ToList();
        sessions = TaskState.Sessions.ToDictionary(x => x.Id, x => x.Name);
        Goals = TaskState.Sessions
        .Select(x => new GoalItem(
            x.Name,
            TaskState.CompletedCount[x.Id][0],
            TaskState.CompletedCount[x.Id][1],
            "green"
        ))
        .ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleTask(ToDoTask task, bool isChecked)
    {
        task.IsCompleted = isChecked;

        await TaskState.OnCheckedChanged(task, isChecked);


        await InvokeAsync(StateHasChanged);

    }

    private void ToEisen()
    {
        Navigation.NavigateTo($"/eisen/{selectedSession}");
    }

    private string PriorityColor(EisenCat cat) => cat switch
    {
        EisenCat.Do => "background-color: red",
        EisenCat.Schedule => "background-color: purple",
        EisenCat.Eliminate => "background-color: gray",
        _ => "background-color: darkorange"
    };

    private string GetTasksDone(List<ToDoTask> ts)
    {
        if (ts == null || ts.Count == 0)
            return "0/0";

        return $"{ts.Count(x => x.IsCompleted)}/{ts.Count}";
    }  

    private async Task OpenSessionModal()
    {
        newSessionName = "";
        await sessionModal.Show();
    }

    private async Task CloseSessionModal()
    {
        await sessionModal.Hide();
    }

    private async Task CreateSession()
    {
        if (string.IsNullOrWhiteSpace(newSessionName))
            return;

        // Add your session here
        var session = await TaskState.CreateSession(new Session(0,TaskState.UserId ,newSessionName));
        await RefreshDashboard(session.Id);

        await sessionModal.Hide();
    }

