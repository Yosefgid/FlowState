@rendermode InteractiveServer
@using FlowState.Blazer.Services
@inject AuthStateServ AuthStateService
@inject NavigationManager Navigation
@implements IDisposable
<Bar Mode="BarMode.VerticalInline"
     CollapseMode="BarCollapseMode.Small"
     ThemeContrast="ThemeContrast.Dark"
     Class="sidebar">

    <BarBrand>
        <BarItem>
            <BarLink>
                <Icon Name="IconName.Bolt" class="me-2 text-cyan" />
                <span class="logo-text">FlowState</span>
            </BarLink>
        </BarItem>
    </BarBrand>

    <BarMenu>
        <BarStart>

            <!-- MAIN -->
            <BarLabel>MAIN</BarLabel>

            <BarItem>
                <BarLink To="/" Match="Match.All">
                    <BarIcon IconName="IconName.ChartBar" />
                    Dashboard
                </BarLink>
            </BarItem>

            <BarItem>
                <BarLink To="/tasks">
                    <BarIcon IconName="IconName.CheckSquare" />
                    Tasks
                </BarLink>
            </BarItem>

            <BarItem>
                <BarLink To="/sessions">
                    <BarIcon IconName="IconName.Clock" />
                    Sessions
                </BarLink>
            </BarItem>

            <BarItem>
                <BarLink To="/calendar">
                    <BarIcon IconName="IconName.Calendar" />
                    Calendar
                </BarLink>
            </BarItem>

            

            <!-- ANALYTICS -->
            <BarLabel>ANALYTICS</BarLabel>

            <BarItem>
                <BarLink To="/reports">
                    <BarIcon IconName="IconName.ChartLine" />
                    Reports
                </BarLink>
            </BarItem>

            <BarItem>
                <BarLink To="/goals">
                    <BarIcon IconName="IconName.Check" />
                    Goals
                </BarLink>
            </BarItem>

            <BarItem>
                <BarLink To="/habits">
                    <BarIcon IconName="IconName.Fire" />
                    Habits
                </BarLink>
            </BarItem>

        </BarStart>

        <BarEnd>
            <BarItem>
                <BarLink To="/settings">
                    <BarIcon IconName="IconName.Settings" />
                    Settings
                </BarLink>
            </BarItem>
            @if (AuthStateService.IsLoggedIn)
            {
                <BarItem>
                    <div class="user-card mt-2">
                        <NavLink href="/profile" class="text-decoration-none">
                            <Div Class="rounded-circle bg-primary text-white d-flex justify-content-center align-items-center avatar-initials">
                                @GetInitials()
                            </Div>
                        
                        </NavLink>
                        
                        <div class="user-info ms-2">
                            <span class="user-name">@AuthStateService.Username</span>
                            <NavLink href="/profile" class="text-decoration-none">My Profile</NavLink>
                            <span class="user-plan">@AuthStateService.Email</span>
                        </div>
                    </div>
                </BarItem>
                <BarItem>
                    <BarLink Clicked="HandleLogout">
                        <BarIcon IconName="IconName.ArrowRight"/>
                        Logout
                    </BarLink>
                </BarItem>

            }
            else
            {
                <BarItem>
                    <BarLink To="/login">
                        <BarIcon IconName="IconName.ArrowRight"/>
                        Login
                    </BarLink>
                </BarItem>
            }
           
        </BarEnd>
    </BarMenu>

</Bar>

@code {
    private bool _initialised = false;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthStateService.InitialiseAsync();
            AuthStateService.OnAuthStateChanged += OnStateChanged;
            StateHasChanged();

        }
        
    }

    private async Task HandleLogout()
    {
        await AuthStateService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetInitials()
    {
        if (string.IsNullOrEmpty(AuthStateService.Username))
            return "?";

        var parts = AuthStateService.Username.Split(' ');
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();

        return AuthStateService.Username[0].ToString().ToUpper();
    }

    public void Dispose()
    {
        AuthStateService.OnAuthStateChanged -= OnStateChanged;
    }
}


