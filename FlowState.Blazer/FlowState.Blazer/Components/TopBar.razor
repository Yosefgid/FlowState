@implements IDisposable
@inject NavigationManager Navigation

<div class="topbar d-flex align-items-center justify-content-left px-4 py-3 gap-5">

    <div class="topbar-title-group">
        <Heading Size="HeadingSize.Is4" Class="page-title mb-0">
            @CurrentPageTitle
        </Heading>

        <Text TextColor="TextColor.Muted" Class="page-subtitle">
            @CurrentPageSubtitle
        </Text>
    </div>

</div>

@code {
  
    private string CurrentPageTitle => GetPageTitle();

    private string CurrentPageSubtitle => GetPageSubtitle();

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private string GetPageTitle()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();

        if (string.IsNullOrEmpty(path) || path == "dashboard")
            return "Dashboard";

        if (path.StartsWith("tasks"))
            return "Tasks";

        if (path == "sessions")
            return "Sessions";

        if (path == "calendar")
            return "Calendar";

        if (path == "profile")
            return "Profile";

        if (path.StartsWith("eisen"))
            return "Eisenhower Matrix";

        return "FlowState";
    }

    private string GetPageSubtitle()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();
      

        if (string.IsNullOrEmpty(path) || path == "dashboard")
            return "Track your productivity at a glance";

        if (path.StartsWith("tasks"))
            return "Manage your tasks and priorities";

        if (path == "sessions")
            return "View and manage focus sessions";

        if (path == "calendar")
            return "Manage your schedule and events";

        if (path == "profile")
            return "Configure your user";

        if (path.StartsWith("eisen"))
            return "Categorise your tasks to maximise productivity";

        return "FlowState";      
    }
}